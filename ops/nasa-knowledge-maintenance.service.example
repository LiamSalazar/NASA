[Unit]
Description=NASA Fire AI controlled document maintenance (example, not installed)
After=network-online.target

[Service]
Type=oneshot
User=liam
WorkingDirectory=/home/liam/NASA
# Bounded discovery, document publication, staged extraction and checkpoint validation.
ExecStart=/home/liam/.local/bin/uv run python scripts/maintain_knowledge.py cycle --execute --max-sources 2
NoNewPrivileges=true
UMask=0077

