me":"Glenn Research Center","location":"Cleveland, United States"}},"id":"8d7f5837055b4f888f7a4cbc295a7067","userType":"CIVIL","userId":"e6ad9f3a70a94fc1a0a4a56bb211746a"},{"organizationId":"fdea3daf3b5156699f511edf3e9b9ec4","sequence":3,"submissionId":20240008602,"meta":{"author":{"orcidId":"","name":"Gary Ruff"},"organization":{"name":"Glenn Research Center","location":"Cleveland, United States"}},"id":"7514b4cf0b0b4e9498f0f4c7a569e200","userType":"CIVIL","userId":"f5daba98616b4f9faeb0dc31767c1f15"}],"stiTypeDetails":"Conference Paper","technicalReviewType":"SINGLE_EXPERT","modified":"2025-08-31T18:39:21.7150190+00:00","id":20240008602,"created":"2024-07-08T16:37:56.9556620+00:00","center":{"code":"GRC","name":"Glenn Research Center","id":"19eeb25fa404421d9eaa5f876e853e3c"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"In order to design a safer spacecraft in terms of fire prevention, detection and cleanup, the transport of combustion products and heat must be predicted. Large-scale fire data was provided by the Saffire payload within Northrup Grumman’s Cygnus vehicle after a resupply mission to the ISS. Solid materials, including thick thermoplastic samples were ignited to study flame spread and the effect a fire has on a vehicle. Sensors that measured species and temperature were placed within Cygnus. A model using Pyrosim was developed to predict the thick fuel burn events from Saffire V by using sensor data from Cygnus. The heat transfer coefficient between the cabin air and cargo was previously calibrated using the cotton fuel burn event, and provided a good prediction of the temperature response within the vehicle during the two thick fuel experiments. The difference between the Saffire inlet CO<sub>2</sub> sensor, and the forward port standoff CO<sub>2</sub> sensor, which is the closest to the Saffire outlet, was used as an input into the model. This method provided an excellent prediction of the CO<sub>2</sub> response in the other parts of the Cygnus.","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","cui":{"isCui":false,"submissionId":20240008602,"id":"5ad09cffb94145c89fa8224e1b05cbc2"},"meetings":[{"country":"US","submissionId":20240008602,"endDate":"2024-07-25T04:00:00.0000000+00:00","sponsors":[{"organizationId":"a4c6a63ed02340b68240e18a1c0d30ce","meta":{"organization":{"name":"International Conference on Environmental Systems (ICES) ","location":""}},"meetingId":"f9e95817d90649678dc67d14f8a31e05","id":"b081e8c8a3ef48f4b231b9430aaec056"}],"name":"53rd International Conference on Environmental Systems","location":"Louisville, KY","id":"f9e95817d90649678dc67d14f8a31e05","url":"https://ices.space/","startDate":"2024-07-21T04:00:00.0000000+00:00"}],"status":"CURATED","related":[],"downloads":[{"draft":false,"mimetype":"application/pdf","name":"ICES-2024-310.pdf","type":"STI","links":{"original":"/api/citations/20240008602/downloads/ICES-2024-310.pdf","pdf":"/api/citations/20240008602/downloads/ICES-2024-310.pdf","fulltext":"/api/citations/20240008602/downloads/ICES-2024-310.pdf.txt"}}],"downloadsAvailable":true,"index":"submissions-2026-10-01-04-12"}