{"copyright":{"thirdPartyPermissionsProduced":false,"disclosedToPublic":false,"containsIndication":false,"publisherPermissionOrRightsToDistribute":false,"belongsToUsGov":false,"determinationType":"PUBLIC_USE_PERMITTED","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"licenseType":"NO","submissionId":20220006164,"containsThirdPartyMaterial":false,"belongsToPublisher":false,"id":"a48db79924274e62b11d6828fb320fb0","belongsToAuthors":false},"subjectCategories":["Spacecraft Propulsion And Power","Aircraft Propulsion And Power"],"keywords":["detonation","combustion"],"exportControl":{"isExportControl":"NO","submissionId":20220006164,"ear":"NO","id":"94d5a6063ae94cf5a9505c202825cdc9","itar":"NO"},"distributionDate":"2022-07-01T04:00:00.0000000+00:00","fundingNumbers":[{"number":"264925.04.22.22","submissionId":20220006164,"id":"15c78b05c49a4831913ab07eb1ac461b","type":"WBS"}],"title":"Computational Fluid Dynamic Optimization of an Experimental Rotating Detonation Rocket Engine Nozzle","stiType":"CONFERENCE_PAPER","distribution":"PUBLIC","submittedDate":"2022-04-21T17:42:59.8412710+00:00","authorAffiliations":[{"organizationId":"fdea3daf3b5156699f511edf3e9b9ec4","sequence":0,"submissionId":20220006164,"meta":{"author":{"orcidId":"","name":"Daniel E Paxson"},"organization":{"name":"Glenn Research Center","location":"Cleveland, Ohio, United States"}},"id":"3df326c95e1a497d806a95cd0e934d6d","userType":"CIVIL","userId":"b12fc2bc778a42deb15c8af933ebde7d"},{"organizationId":"fdea3daf3b5156699f511edf3e9b9ec4","sequence":1,"submissionId":20220006164,"meta":{"author":{"orcidId":"","name":"Kenji Miki"},"organization":{"name":"Glenn Research Center","location":"Cleveland, Ohio, United States"}},"id":"80e77a0b853b4d0c82dc5465f273e300","userType":"CIVIL","userId":"3fdae4edf643418bb6ad928799ce10d6"},{"organizationId":"fdea3daf3b5156699f511edf3e9b9ec4","sequence":2,"submissionId":20220006164,"meta":{"author":{"orcidId":"","name":"H Douglas Perkins"},"organization":{"name":"Glenn Research Center","location":"Cleveland, Ohio, United States"}},"id":"27b042f8d925442282bc5f800b24cc23","userType":"CIVIL","userId":"a953c3aa5f4f40cc9913edf7a4af913d"},{"organizationId":"44b59c87ea2f42cb961e74070737a164","sequence":3,"submissionId":20220006164,"meta":{"author":{"orcidId":"","name":"Shaye Yungster"},"organization":{"name":"HX5, LLC","location":""}},"id":"a20e24cb43f14254abe6fa7f057b24d4","userType":"CONTRACTOR_GRANTEE","userId":"37c9e92467b24365bebea9b7ac555e51"}],"stiTypeDetails":"Conference Paper","technicalReviewType":"NASA_PEER_COMMITTEE","modified":"2025-08-31T18:39:21.7150190+00:00","id":20220006164,"created":"2022-04-21T17:12:27.1663460+00:00","center":{"code":"GRC","name":"Glenn Research Center","id":"19eeb25fa404421d9eaa5f876e853e3c"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"A  parametric  optimization  study  is  performed  on  the  nozzle  of  a  laboratory  rotating  detonation  rocket  engine  (RDRE)  using  a  three-dimensional  computational  fluid  dynamic  simulation.  The primary optimization objective is maximum nozzle thrust.  The basic nozzle configuration is a shrouded, truncated plug.  The fluid in the RDRE chamber leading to the nozzle is choked at its exit so that its cyclic behavior is unaffected by any changes to the nozzle design.  Optimization is performed for a single operating point.  Parameters varied are the overall nozzle area expansion ratio and the fraction of the expansion area that is provided by the shroud.  These two parameters indirectly affect the angle of the plug nozzle cone, and the bluff  body  area  associated  with  its  truncation.    Nozzle  thrust  is  evaluated  as  the  difference  between the thrust of the RDRE chamber-plus-nozzle combination and that of the chamber alone.  The nozzle produces approximately 20% of the total engine thrust.  The baseline nozzle is found to perform well, yielding 58.1% of the thrust calculated for a notional ideal RDRE nozzle  which  can  instantaneously  change  shape  to  allow  isentropic  expansion  of  every  fluid  element.  Optimization improves the performance, bringing the nozzle thrust to 70.0% of the notional ideal, and total engine thrust (chamber-plus-nozzle) to 94% of the ideal.","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","cui":{"isCui":false,"submissionId":20220006164,"id":"4510142761414cbd961b5b9adc11fab9"},"meetings":[{"country":"US","submissionId":20220006164,"endDate":"2022-07-01T04:00:00.0000000+00:00","sponsors":[{"organizationId":"71fb4af96d4a59b5a0a2084db7b4ce35","meta":{"organization":{"name":"American Institute of Aeronautics and Astronautics","location":"Reston, Virginia, United States"}},"meetingId":"212665d02f0f4dceaae3602cd65f9eaa","id":"d41ea0a59960445aa7f0c4da879d5a76"}],"name":"AIAA Aviation Forum","location":"Chicago, Illinois","id":"212665d02f0f4dceaae3602cd65f9eaa","url":"https://www.aiaa.org/aviation","startDate":"2022-06-27T04:00:00.0000000+00:00"}],"status":"CURATED","related":[],"downloads":[{"draft":false,"mimetype":"application/pdf","name":"Aviation_2022_final.pdf","type":"STI","links":{"original":"/api/citations/20220006164/downloads/Aviation_2022_final.pdf","pdf":"/api/citations/20220006164/downloads/Aviation_2022_final.pdf","fulltext":"/api/citations/20220006164/downloads/Aviation_2022_final.pdf.txt"}}],"downloadsAvailable":true,"index":"submissions-2026-10-08-04-13"}