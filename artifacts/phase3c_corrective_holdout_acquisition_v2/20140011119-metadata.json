rganization":{"name":"Argonne National Lab.","location":"IL, United States"}},"id":"d1feb555cacc48b4a43e60dfe6317191"},{"sequence":3,"submissionId":20140011119,"meta":{"author":{"name":"Faluvegi, Greg"},"organization":{"name":"Columbia Univ.","location":"New York, NY, United States"}},"id":"b1d9984805dd4535962346bdc49c6517"}],"stiTypeDetails":"Reprint (Version printed in journal)","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2025-08-31T18:39:21.7150190+00:00","id":20140011119,"sourceIdentifiers":[{"number":"doi:10.1002/grl.50805","submissionId":20140011119,"id":"3ef3f8686b9a49b89c34b69a8b7b30f8","type":"DOI"},{"submissionId":20140011119,"id":"b614feab0b1d4d6a858e74f422ef8f08","descriptor":"doi:10.1002/grl.50805"}],"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":""},"created":"2014-08-27T09:08:41.6000000+00:00","center":{"code":"GSFC","name":"Goddard Space Flight Center","id":"973fae00c3584b9fb4c762ae9870d0f6"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"Understanding the radiative forcing caused by anthropogenic aerosol sources is essential for making effective emission control decisions to mitigate climate change. We examined the net direct plus indirect radiative forcing caused by carbonaceous aerosol and sulfur emissions in key sectors of China and India using the GISS-E2 chemistry-climate model. Diesel trucks and buses (67 mW/ sq. m) and residential biofuel combustion (52 mW/ sq. m) in India have the largest global mean, annual average forcings due mainly to the direct and indirect effects of BC. Emissions from these two sectors in China have near-zero net global forcings. Coal-fired power plants in both countries exert a negative forcing of about -30 mW/ sq. m from production of sulfate. Aerosol forcings are largest locally, with direct forcings due to residential biofuel combustion of 580 mW/ sq. m over India and 416 mW/ sq. m over China, but they extend as far as North America, Europe, and the Arctic","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","publications":[{"volume":"40","submissionId":20140011119,"issue":"16","issn":"0094-8276","publisher":"Wiley-Blackwell","id":"470e8dc289b94e40a229b5c40076d157","publicationName":"Geophysical Research Letters","publicationDate":"2013-08-28T00:00:00.0000000+00:00"}],"status":"CURATED","related":[],"downloads":[{"draft":false,"mimetype":"application/pdf","name":"20140011119.pdf","type":"STI","links":{"original":"/api/citations/20140011119/downloads/20140011119.pdf","pdf":"/api/citations/20140011119/downloads/20140011119.pdf","fulltext":"/api/citations/20140011119/downloads/20140011119.txt"}}],"downloadsAvailable":true,"index":"submissions-2026-10-08-04-13"}