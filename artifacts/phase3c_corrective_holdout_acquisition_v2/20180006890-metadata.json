{"copyright":{"thirdPartyPermissionsProduced":false,"disclosedToPublic":false,"containsIndication":false,"publisherPermissionOrRightsToDistribute":false,"belongsToUsGov":false,"determinationType":"PUBLIC_USE_PERMITTED","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"submissionId":20180006890,"containsThirdPartyMaterial":false,"belongsToPublisher":false,"id":"d03412b04f7d4262a8a4b5dcc5704a38","belongsToAuthors":false},"subjectCategories":["Aircraft Propulsion And Power"],"keywords":["combustion","detonation"],"exportControl":{"isExportControl":"NO","eccnNumber":"","submissionId":20180006890,"ear":"NO","id":"548db155c88b4efcb1671cd855ca0b98","itar":"NO"},"distributionDate":"2019-07-12T00:00:00.0000000+00:00","otherReportNumbers":["GRC-E-DAA-TN57340","Report Number: GRC-E-DAA-TN57340"],"fundingNumbers":[{"number":"WBS 109492.02.03.02.30","submissionId":20180006890,"id":"40c85aa1aecf48be9f5f0e8c3cb0aa8c","type":"WBS"}],"title":"Determining the Pressure Gain of Pressure Gain Combustion","stiType":"CONFERENCE_PAPER","distribution":"PUBLIC","submittedDate":"2018-10-25T13:59:12.2500000+00:00","authorAffiliations":[{"sequence":0,"submissionId":20180006890,"meta":{"author":{"name":"Kaemming, Thomas A."},"organization":{"name":"Innovative Scientific Solutions, Inc.","location":"Dayton, OH, United States"}},"id":"6f7cd34edd1d48b9a6e95a14fe187d57"},{"sequence":1,"submissionId":20180006890,"meta":{"author":{"name":"Paxson, Daniel E."},"organization":{"name":"NASA Glenn Research Center","location":"Cleveland, OH, United States"}},"id":"51dc2805254f4c0f8714887994522f46"}],"stiTypeDetails":"Conference Paper","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2025-08-31T18:39:21.7150190+00:00","id":20180006890,"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":""},"created":"2018-10-25T13:59:12.2500000+00:00","center":{"code":"GRC","name":"Glenn Research Center","id":"19eeb25fa404421d9eaa5f876e853e3c"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"Over the past few decades, there has been significant research into propulsion concepts attempting to employ pressure gain combustion. Pressure gain combustion concepts to date have resulted in dynamic, non-uniform gas flows which are difficult to characterize and compare with more conventional forms of propulsion. This paper proposes a technique to derive for the pressure gain combustion device an equivalent, steady, uniform gas pressure that is available to do work or provide thrust, thereby providing a direct comparison with conventional propulsive devices.","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","meetings":[{"submissionId":20180006890,"name":"American Inst. of Aeronautics and Astronautics","location":"Reston, VA, United States","id":"83db17ad4aea4ba58c86cc8ca52adb79"},{"country":"United States","submissionId":20180006890,"endDate":"2018-07-13T00:00:00.0000000+00:00","sponsors":[{"meta":{"organization":{"name":"American Inst. of Aeronautics and Astronautics","location":"Reston, VA, United States"}},"meetingId":"e54b37d948754aa19e2d1b5f9d8dfefd","id":"2e27890e4b5b4eccb3b8657cbc28d1bd"}],"name":"AIAA Propulsion & Energy 2018","location":"Cincinnati, OH","id":"e54b37d948754aa19e2d1b5f9d8dfefd","startDate":"2018-07-07T00:00:00.0000000+00:00"}],"publications":[{"submissionId":20180006890,"id":"a06c357c91de4842ab287952a4da7473","publicationDate":"2018-07-07T00:00:00.0000000+00:00"}],"status":"CURATED","related":[],"downloads":[{"draft":false,"mimetype":"application/pdf","name":"20180006890.pdf","type":"STI","links":{"original":"/api/citations/20180006890/downloads/20180006890.pdf","pdf":"/api/citations/20180006890/downloads/20180006890.pdf","fulltext":"/api/citations/20180006890/downloads/20180006890.txt"}}],"downloadsAvailable":true,"index":"submissions-2026-10-08-04-13"}