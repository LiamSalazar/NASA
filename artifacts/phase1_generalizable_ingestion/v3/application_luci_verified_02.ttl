    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"measured_observation\", \"evidence_ids\": [\"E-6a062578a8bc9b381a5d6bf0\"], \"id\": \"proposal-08e9d42d67e05c2741879472\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Lunar Combustion Investigation: Flammability Results from a Rotating Sounding Rocket\", \"text\": \"\\u2022\\nTwo samples are burned simultaneously in air at normal pressure: Cotton-fiberglass composite fabric sheet and a 4-mm diameter \\nrod of acrylic plastic (polymethyl methacrylate).\"}" ;
