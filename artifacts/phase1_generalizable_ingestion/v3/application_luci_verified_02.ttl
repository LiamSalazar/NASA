    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"experimental_configuration\", \"evidence_ids\": [\"E-49e271d94011afe76cb7c262\"], \"id\": \"proposal-004147c5860b3477620ea77d\", \"review_status\": \"APPROVED\", \"scope\": [\"research-88a2411be5fc53d76df5:entity:53f5e43b83ac379ac842\"], \"scope_applicability\": \"Lunar Combustion Investigation: Flammability Results from a Rotating Sounding Rocket\", \"text\": \"Two samples: Fabric 5 cm wide x 30 cm \\nlong and 4-mm-DIA acrylic, (PMMA); \\nignited with slight pause between \\nthem.\"}" ;
