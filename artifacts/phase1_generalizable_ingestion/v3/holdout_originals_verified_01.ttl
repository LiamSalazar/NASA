ns1:proposal-3f86088acd7b501344a3cae7 a ns1:NASAConclusion ;
    ns1:canonical false ;
    ns1:evidenceRef "E-190389e9cffcbd8623c3b8de" ;
    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"tentative_interpretation\", \"evidence_ids\": [\"E-190389e9cffcbd8623c3b8de\"], \"id\": \"proposal-3f86088acd7b501344a3cae7\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Wire-break Ignition Testing of Materials for Spacesuit Fire Hazard Control\", \"text\": \"Therefore, using power exclusively \\nto describe performance of the material is insufficient and suggests that more information is needed for a fair and \\nhonest application of the data to occur.\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
    ns1:source ns1:research-5e2b3941a6f077006182%3A48390bbce022b7a9 .

ns1:proposal-632efa26ea85f5c4bf4951eb a ns1:ReportedObservation ;
    ns1:canonical false ;
    ns1:evidenceRef "E-4d2fa6554ac45fbbc7d3a56c" ;
    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"measured_observation\", \"evidence_ids\": [\"E-4d2fa6554ac45fbbc7d3a56c\"], \"id\": \"proposal-632efa26ea85f5c4bf4951eb\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Wire-break Ignition Testing of Materials for Spacesuit Fire Hazard Control\", \"text\": \"Hence, on the rightmost plot, the orange series \\nwith the magnetic clamping fixture is in line with the gray screw-terminal clamping fixture and a clearer picture of \\nthe actual material performance is observed.\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
    ns1:source ns1:research-5e2b3941a6f077006182%3A48390bbce022b7a9 .

ns1:proposal-73eb9678db89391431746395 a ns1:ReportedObservation ;
    ns1:canonical false ;
    ns1:evidenceRef "E-190389e9cffcbd8623c3b8de" ;
    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"measured_observation\", \"evidence_ids\": [\"E-190389e9cffcbd8623c3b8de\"], \"id\": \"proposal-73eb9678db89391431746395\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Wire-break Ignition Testing of Materials for Spacesuit Fire Hazard Control\", \"text\": \"10 \\nInternational Conference on Environmental Systems \\n \\n \\n \\nFigure 7 - KER 54-1 Wire-Break Test \\n \\nLogically, it stands to reason that the ignition and burning of the material should be observed at these higher power \\nlevels rather than at the final lower power where the wire did fuse open.\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
    ns1:source ns1:research-5e2b3941a6f077006182%3A48390bbce022b7a9 .

ns1:proposal-80d4dea8b7758e8d5b45f1fe a ns1:ReportedObservation ;
    ns1:canonical false ;
    ns1:evidenceRef "E-190389e9cffcbd8623c3b8de" ;
    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"measured_observation\", \"evidence_ids\": [\"E-190389e9cffcbd8623c3b8de\"], \"id\": \"proposal-80d4dea8b7758e8d5b45f1fe\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Wire-break Ignition Testing of Materials for Spacesuit Fire Hazard Control\", \"text\": \"If time is taken into account, then what is \\nreally being described and observed is the energy or work that it takes to get the material to become pyrolyzed to the \\npoint that it can be ignited and burned.\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
    ns1:source ns1:research-5e2b3941a6f077006182%3A48390bbce022b7a9 .

ns1:proposal-9e987278955cb2201d01ae22 a ns1:ReportedObservation ;
    ns1:canonical false ;
    ns1:evidenceRef "E-190389e9cffcbd8623c3b8de" ;
    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"measured_observation\", \"evidence_ids\": [\"E-190389e9cffcbd8623c3b8de\"], \"id\": \"proposal-9e987278955cb2201d01ae22\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Wire-break Ignition Testing of Materials for Spacesuit Fire Hazard Control\", \"text\": \"Conversely, it could also be shown that the \\nmaterial can also be ignited at a lower power level lower than observed in the test.\"}" ;
