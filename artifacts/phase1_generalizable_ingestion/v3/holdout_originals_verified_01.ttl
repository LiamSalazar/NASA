ns1:research-5e2b3941a6f077006182%3A48390bbce022b7a9%3Astatement%3A9406940df7af2d98 a ns1:NASAConclusion ;
    ns1:canonical false ;
    ns1:evidenceRef "E-b7c40e5c0595c02e6ae0f053" ;
    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"author_reported_conclusion\", \"evidence_ids\": [\"E-b7c40e5c0595c02e6ae0f053\"], \"id\": \"research-5e2b3941a6f077006182:48390bbce022b7a9:statement:9406940df7af2d98\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Wire-break Ignition Testing of Materials for Spacesuit Fire Hazard Control\", \"text\": \"Conclusion \\nThe wire-break ignition test was developed after re-creation and review of the Apollo era tests that employed \\nscratch and poke electrode techniques to devise a more repeatable and conservative test that still represents a system \\nfailure mode.\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
    ns1:source ns1:research-5e2b3941a6f077006182%3A48390bbce022b7a9 .

