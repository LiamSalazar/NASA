ns1:proposal-2f63554867d1103b44de0446 a ns1:NASAConclusion ;
    ns1:canonical false ;
    ns1:evidenceRef "E-4d2fa6554ac45fbbc7d3a56c" ;
    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"tentative_interpretation\", \"evidence_ids\": [\"E-4d2fa6554ac45fbbc7d3a56c\"], \"id\": \"proposal-2f63554867d1103b44de0446\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Wire-break Ignition Testing of Materials for Spacesuit Fire Hazard Control\", \"text\": \"Likewise, a similar \\napproach may be used in adopting the I2t term and applying it to a material and thinking of the material in much the \\nsame manner as a fuse or breaker, where the interest is in protecting the material from a total energy input that would \\nlead it to become ignited.\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
    ns1:source ns1:research-5e2b3941a6f077006182%3A48390bbce022b7a9 .

