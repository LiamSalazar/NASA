ns1:research-673e8dc214da9478bc45%3Ab4b64e88992718a7%3Astatement%3A3742d63f5377721b a ns1:ReportedObservation ;
    ns1:canonical false ;
    ns1:evidenceRef "E-6a4fb43bfaf5e7a5d092ac7d" ;
    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"measured_observation\", \"evidence_ids\": [\"E-6a4fb43bfaf5e7a5d092ac7d\"], \"id\": \"research-673e8dc214da9478bc45:b4b64e88992718a7:statement:3742d63f5377721b\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Risks of Depress as a Fire Suppression Technique in Spacecraft\", \"text\": \"It is worth noting that the Nomex material \\nwas chosen as a candidate material that self-\\nextinguished at 30% oxygen and 14.7 psia in \\nthe J-configuration.\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
    ns1:source ns1:research-673e8dc214da9478bc45%3Ab4b64e88992718a7 .

ns1:research-673e8dc214da9478bc45%3Ab4b64e88992718a7%3Astatement%3A3ca9a0ce3d91950e a ns1:ReportedObservation ;
    ns1:canonical false ;
    ns1:evidenceRef "E-7ccba4c2bf7eb60a200ca085" ;
    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"measured_observation\", \"evidence_ids\": [\"E-7ccba4c2bf7eb60a200ca085\"], \"id\": \"research-673e8dc214da9478bc45:b4b64e88992718a7:statement:3ca9a0ce3d91950e\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Risks of Depress as a Fire Suppression Technique in Spacecraft\", \"text\": \"Samples were allowed to burn until either the sample was fully consumed or extinguished.\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
    ns1:source ns1:research-673e8dc214da9478bc45%3Ab4b64e88992718a7 .

ns1:research-673e8dc214da9478bc45%3Ab4b64e88992718a7%3Astatement%3A4c396e8bf57da5e3 a ns1:ReportedObservation ;
    ns1:canonical false ;
    ns1:evidenceRef "E-2fc973b7e0903d1a09c86082" ;
    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"measured_observation\", \"evidence_ids\": [\"E-2fc973b7e0903d1a09c86082\"], \"id\": \"research-673e8dc214da9478bc45:b4b64e88992718a7:statement:4c396e8bf57da5e3\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Risks of Depress as a Fire Suppression Technique in Spacecraft\", \"text\": \"There is no record \\nof the venting rate used in the evaluation or the pressure where extinguishment was achieved, however it was observed \\nthat there was a substantial difference between the slow flame spread under quiescent conditions and the rapid flame \\nspread that was observed during depressurization venting.\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
    ns1:source ns1:research-673e8dc214da9478bc45%3Ab4b64e88992718a7 .

ns1:research-673e8dc214da9478bc45%3Ab4b64e88992718a7%3Astatement%3A59743c0e6871a094 a ns1:ReportedObservation ;
    ns1:canonical false ;
    ns1:evidenceRef "E-296c9003cc6b7365dc7a38f6" ;
    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"measured_observation\", \"evidence_ids\": [\"E-296c9003cc6b7365dc7a38f6\"], \"id\": \"research-673e8dc214da9478bc45:b4b64e88992718a7:statement:59743c0e6871a094\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Risks of Depress as a Fire Suppression Technique in Spacecraft\", \"text\": \"Cold \\nsamples extinguished more easily at pressures \\nnear 0.25 Atmospheres (Atm) (3.675 psia, 25.3 \\nkPa) but samples with more residual heat from \\na longer burn duration survived to less than 0.1 \\nAtm (1.47 psia, 10.03 kPa), as shown in Figure \\n1.\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
    ns1:source ns1:research-673e8dc214da9478bc45%3Ab4b64e88992718a7 .

