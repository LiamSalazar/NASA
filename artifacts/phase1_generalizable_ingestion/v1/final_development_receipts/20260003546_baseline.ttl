ns1:proposal-0c7bbb8678a98be6753215fd a ns1:NASAConclusion ;
    ns1:canonical false ;
    ns1:evidenceRef "E-296c9003cc6b7365dc7a38f6" ;
    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"tentative_interpretation\", \"evidence_ids\": [\"E-296c9003cc6b7365dc7a38f6\"], \"id\": \"proposal-0c7bbb8678a98be6753215fd\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Risks of Depress as a Fire Suppression Technique in Spacecraft\", \"text\": \"Other programs may propose similar mitigation strategies that involve \\ndepressurization, possibly combined with a nitrogen backfill, to achieve extinguishment.\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
    ns1:source ns1:research-673e8dc214da9478bc45%3Ab4b64e88992718a7 .

ns1:proposal-4e5752c1f66dea4af8680be6 a ns1:ExperimentalCondition ;
    ns1:canonical false ;
    ns1:evidenceRef "E-7ccba4c2bf7eb60a200ca085" ;
    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"experimental_configuration\", \"evidence_ids\": [\"E-7ccba4c2bf7eb60a200ca085\"], \"id\": \"proposal-4e5752c1f66dea4af8680be6\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Risks of Depress as a Fire Suppression Technique in Spacecraft\", \"text\": \"A test \\nchamber, 1.13 m3, housed test samples at an initial pressure of 14.7 psia (101.35 kPa).\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
    ns1:source ns1:research-673e8dc214da9478bc45%3Ab4b64e88992718a7 .

ns1:proposal-54c781ee03712ef6ea6df61c a ns1:ExperimentalCondition ;
    ns1:canonical false ;
    ns1:evidenceRef "E-296c9003cc6b7365dc7a38f6" ;
    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"experimental_configuration\", \"evidence_ids\": [\"E-296c9003cc6b7365dc7a38f6\"], \"id\": \"proposal-54c781ee03712ef6ea6df61c\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Risks of Depress as a Fire Suppression Technique in Spacecraft\", \"text\": \"Materials and Methods \\nTo better understand the behavior of a fire during depressurization, a series of tests were performed using the \\nNASA-STD-6001 [5] Test 1 upward propagation test configuration.\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
    ns1:source ns1:research-673e8dc214da9478bc45%3Ab4b64e88992718a7 .

ns1:proposal-5e504a8d5d5ff307fbf21b47 a ns1:OpenQuestion ;
    ns1:canonical false ;
    ns1:evidenceRef "E-08ad69a0554df8624a6ce0d5" ;
    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"open_question\", \"evidence_ids\": [\"E-08ad69a0554df8624a6ce0d5\"], \"id\": \"proposal-5e504a8d5d5ff307fbf21b47\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Risks of Depress as a Fire Suppression Technique in Spacecraft\", \"text\": \"Conclusion and Future Work \\nTesting of Nomex showed that sufficiently high velocity can blow off flames.\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
    ns1:source ns1:research-673e8dc214da9478bc45%3Ab4b64e88992718a7 .

ns1:proposal-84a63881bd016ad7fe4732c8 a ns1:Intervention ;
    ns1:canonical false ;
    ns1:evidenceRef "E-296c9003cc6b7365dc7a38f6" ;
    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"experimental_configuration\", \"evidence_ids\": [\"E-296c9003cc6b7365dc7a38f6\"], \"id\": \"proposal-84a63881bd016ad7fe4732c8\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Risks of Depress as a Fire Suppression Technique in Spacecraft\", \"text\": \"Oxygen was reintroduced after \\na predetermined dwell time to understand reigntion.\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
    ns1:source ns1:research-673e8dc214da9478bc45%3Ab4b64e88992718a7 .

ns1:proposal-88dfad3ae151966ba365c1fe a ns1:ExperimentalCondition ;
    ns1:canonical false ;
    ns1:evidenceRef "E-0da92272426b7d4bc88155a2" ;
    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"experimental_configuration\", \"evidence_ids\": [\"E-0da92272426b7d4bc88155a2\"], \"id\": \"proposal-88dfad3ae151966ba365c1fe\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Risks of Depress as a Fire Suppression Technique in Spacecraft\", \"text\": \"ABS is a stiff material that cannot be formed in the J-\\nconfiguration, therefore all ABS tests were performed with edge \\nignition only.\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
    ns1:source ns1:research-673e8dc214da9478bc45%3Ab4b64e88992718a7 .

ns1:proposal-972d00f41cbf267170d204e3 a ns1:NASAConclusion ;
    ns1:canonical false ;
    ns1:evidenceRef "E-2fc973b7e0903d1a09c86082" ;
    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"tentative_interpretation\", \"evidence_ids\": [\"E-2fc973b7e0903d1a09c86082\"], \"id\": \"proposal-972d00f41cbf267170d204e3\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Risks of Depress as a Fire Suppression Technique in Spacecraft\", \"text\": \"Challenges  posed by venting \\ninclude: air movement induced by the venting process can increase fire damage until fire extinguishment is achieved; \\nhardware and systems need to be certified to survive vacuum; crew evacuation is required; potential exterior damage \\nto the spacecraft from evacuated particulate; risk of foreign object damage from the venting process to the vent valve \\n(critical to spacecraft integrity); weight and volume penalty of  the large valve needed to vent quickly; and in vacuum, \\nmaterials will cool slowly so reentry may be delayed.\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
    ns1:source ns1:research-673e8dc214da9478bc45%3Ab4b64e88992718a7 .

ns1:proposal-9b66c42f137e199a7be25e65 a ns1:ExperimentalCondition ;
    ns1:canonical false ;
    ns1:evidenceRef "E-141599a7e54260423e383d79" ;
    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"experimental_configuration\", \"evidence_ids\": [\"E-141599a7e54260423e383d79\"], \"id\": \"proposal-9b66c42f137e199a7be25e65\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Risks of Depress as a Fire Suppression Technique in Spacecraft\", \"text\": \"Preliminary tests were performed on \\ndifferent materials to aid in the selection \\nof best test materials by characterizing blowoff velocities required for each material.\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
    ns1:source ns1:research-673e8dc214da9478bc45%3Ab4b64e88992718a7 .

ns1:proposal-a989141836b173adcf7b95ee a ns1:Intervention ;
    ns1:canonical false ;
    ns1:evidenceRef "E-296c9003cc6b7365dc7a38f6" ;
    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"experimental_configuration\", \"evidence_ids\": [\"E-296c9003cc6b7365dc7a38f6\"], \"id\": \"proposal-a989141836b173adcf7b95ee\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Risks of Depress as a Fire Suppression Technique in Spacecraft\", \"text\": \"Nitrogen was then introduced until the targeted lower \\noxygen concentration was achieved.\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
    ns1:source ns1:research-673e8dc214da9478bc45%3Ab4b64e88992718a7 .

ns1:proposal-ab9501ffe1563001dcdcd709 a ns1:NASAConclusion ;
    ns1:canonical false ;
    ns1:evidenceRef "E-296c9003cc6b7365dc7a38f6" ;
    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"tentative_interpretation\", \"evidence_ids\": [\"E-296c9003cc6b7365dc7a38f6\"], \"id\": \"proposal-ab9501ffe1563001dcdcd709\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Risks of Depress as a Fire Suppression Technique in Spacecraft\", \"text\": \"However, \\nthe potential advantage with this approach may not outweigh the risk since although the venting time is shortened, it \\nis still significant when combined with the time it takes to backfill with nitrogen to ensure extinguishment.\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
    ns1:source ns1:research-673e8dc214da9478bc45%3Ab4b64e88992718a7 .

ns1:proposal-b830028e05159ee3f46699ea a ns1:NASAConclusion ;
    ns1:canonical false ;
    ns1:evidenceRef "E-6a4fb43bfaf5e7a5d092ac7d" ;
    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"tentative_interpretation\", \"evidence_ids\": [\"E-6a4fb43bfaf5e7a5d092ac7d\"], \"id\": \"proposal-b830028e05159ee3f46699ea\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Risks of Depress as a Fire Suppression Technique in Spacecraft\", \"text\": \"While this may be \\nintuitive (sudden high velocity flow across the \\nsurface), it shows that the flow increases the area of \\nimpact for the flame to the surrounding volumes.\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
    ns1:source ns1:research-673e8dc214da9478bc45%3Ab4b64e88992718a7 .

ns1:proposal-c031d797b87d36454d0dcac8 a ns1:ExperimentalCondition ;
    ns1:canonical false ;
    ns1:evidenceRef "E-2850db00fab6b98d44699cd1" ;
    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"experimental_configuration\", \"evidence_ids\": [\"E-2850db00fab6b98d44699cd1\"], \"id\": \"proposal-c031d797b87d36454d0dcac8\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Risks of Depress as a Fire Suppression Technique in Spacecraft\", \"text\": \"The depressurization rate decreased with time as shown in Figure 7, with a steep initial pressure drop that gradually \\ndecreased as the test chamber pressure dropped to approximately 1 psia (6.9 kPa).\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
    ns1:source ns1:research-673e8dc214da9478bc45%3Ab4b64e88992718a7 .

ns1:proposal-d062aee915926b93b4c9f8ce a ns1:ExperimentalCondition ;
    ns1:canonical false ;
    ns1:evidenceRef "E-296c9003cc6b7365dc7a38f6" ;
    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"experimental_configuration\", \"evidence_ids\": [\"E-296c9003cc6b7365dc7a38f6\"], \"id\": \"proposal-d062aee915926b93b4c9f8ce\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Risks of Depress as a Fire Suppression Technique in Spacecraft\", \"text\": \"The testing was performed \\nwith Beefy T cotton t-shirt material and nylon lacing tape in a \\nISO 4589-4 Test apparatus modified to operate in sub ambient \\npressures.\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
    ns1:source ns1:research-673e8dc214da9478bc45%3Ab4b64e88992718a7 .

ns1:proposal-e036793b293ab73597a6fef2 a ns1:NASAConclusion ;
    ns1:canonical false ;
    ns1:evidenceRef "E-6a4fb43bfaf5e7a5d092ac7d" ;
    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"tentative_interpretation\", \"evidence_ids\": [\"E-6a4fb43bfaf5e7a5d092ac7d\"], \"id\": \"proposal-e036793b293ab73597a6fef2\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Risks of Depress as a Fire Suppression Technique in Spacecraft\", \"text\": \"In \\noperation, this risks exposing the flame to local \\nareas that otherwise may not have been impacted by \\nthe burning material.\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
    ns1:source ns1:research-673e8dc214da9478bc45%3Ab4b64e88992718a7 .

ns1:proposal-eda4aeb28a34985235753c28 a ns1:NASAConclusion ;
    ns1:canonical false ;
    ns1:evidenceRef "E-2fc973b7e0903d1a09c86082" ;
    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"tentative_interpretation\", \"evidence_ids\": [\"E-2fc973b7e0903d1a09c86082\"], \"id\": \"proposal-eda4aeb28a34985235753c28\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Risks of Depress as a Fire Suppression Technique in Spacecraft\", \"text\": \"Other tests performed were considered invalid as \\nthe PTFE and nylon samples had ignition difficulties and the mylar sample may not have been vented.\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
