    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"measured_observation\", \"evidence_ids\": [\"E-3dde136f79e6d3ee2a27b2fb\"], \"id\": \"research-673e8dc214da9478bc45:b4b64e88992718a7:statement:0291a556ac752e37\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Risks of Depress as a Fire Suppression Technique in Spacecraft\", \"text\": \"As discussed in \\nSection B, materials continued to burn near \\nand below 1 psia (6.9 kPa) for both the cotton \\nt-shirt \\nand \\nABS \\ntest \\nsamples.\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
    ns1:source ns1:research-673e8dc214da9478bc45%3Ab4b64e88992718a7 .

