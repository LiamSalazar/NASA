    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"experimental_configuration\", \"evidence_ids\": [\"E-296c9003cc6b7365dc7a38f6\"], \"id\": \"proposal-ede6dbba84a15fa8a3d5c984\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Risks of Depress as a Fire Suppression Technique in Spacecraft\", \"text\": \"To standardize the test approach, the test environment was maintained at \\n30% oxygen and 14.7 psia (101.35 kPa) for all tests.\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
