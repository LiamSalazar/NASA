    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"author_reported_conclusion\", \"evidence_ids\": [\"E-3dde136f79e6d3ee2a27b2fb\"], \"id\": \"research-673e8dc214da9478bc45:b4b64e88992718a7:statement:6eb4d5665fac15c7\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Risks of Depress as a Fire Suppression Technique in Spacecraft\", \"text\": \"This \\ndemonstrated \\nthat \\nthe \\ncombination \\nof \\ndepressurization blow-off and reduction of oxygen partial pressure were both insufficient to extinguish the fire.\"}" ;
