    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"tentative_interpretation\", \"evidence_ids\": [\"E-3dde136f79e6d3ee2a27b2fb\"], \"id\": \"research-673e8dc214da9478bc45:b4b64e88992718a7:statement:af87e163f2e84324\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Risks of Depress as a Fire Suppression Technique in Spacecraft\", \"text\": \"At the point of extinguishment, it is not clear \\nwhether the fire extinguished due to low pressure or the consumption of oxygen in the chamber, but based on the \\nduration of the test, it was likely the lack of oxygen rather than the absolute pressure that resulted in extinguishment.\"}" ;
