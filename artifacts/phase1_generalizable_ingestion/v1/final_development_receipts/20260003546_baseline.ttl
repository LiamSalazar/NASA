    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"measured_observation\", \"evidence_ids\": [\"E-767370b5d999b47dcd722b69\"], \"id\": \"research-673e8dc214da9478bc45:b4b64e88992718a7:statement:c28dddd5859903fa\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Risks of Depress as a Fire Suppression Technique in Spacecraft\", \"text\": \"However, \\nwithin \\na \\nfew \\nseconds of depress \\nending, \\nthe \\nmaterial appeared \\nto reignite, as shown in Figure 10, despite the fact that no gas was introduced into the chamber.\"}" ;
