    ns1:canonical false ;
    ns1:evidenceRef "E-296c9003cc6b7365dc7a38f6" ;
    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"measured_observation\", \"evidence_ids\": [\"E-296c9003cc6b7365dc7a38f6\"], \"id\": \"research-673e8dc214da9478bc45:b4b64e88992718a7:statement:2ba3112378c2c8d1\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Risks of Depress as a Fire Suppression Technique in Spacecraft\", \"text\": \"The test was repeated \\nwith new samples for each target oxygen concentration until \\nextinguishment was observed.\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
    ns1:source ns1:research-673e8dc214da9478bc45%3Ab4b64e88992718a7 .

