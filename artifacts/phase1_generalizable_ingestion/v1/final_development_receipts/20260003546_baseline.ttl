    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"measured_observation\", \"evidence_ids\": [\"E-141599a7e54260423e383d79\"], \"id\": \"research-673e8dc214da9478bc45:b4b64e88992718a7:statement:cb6daae80770fdf5\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Risks of Depress as a Fire Suppression Technique in Spacecraft\", \"text\": \"Materials with high blow off \\nvelocities will continue to burn despite \\nturbulent flows during depressurization \\nuntil sufficient oxygen is removed to \\ninduce extinguishment.\"}" ;
