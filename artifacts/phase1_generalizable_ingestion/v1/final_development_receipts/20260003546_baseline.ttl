    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"measured_observation\", \"evidence_ids\": [\"E-2850db00fab6b98d44699cd1\"], \"id\": \"research-673e8dc214da9478bc45:b4b64e88992718a7:statement:3583d50aa0df53bb\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Risks of Depress as a Fire Suppression Technique in Spacecraft\", \"text\": \"Nomex, however, was \\nextinguished in two of the four tests.\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
