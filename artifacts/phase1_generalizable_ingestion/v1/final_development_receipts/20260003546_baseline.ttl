    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"measured_observation\", \"evidence_ids\": [\"E-08ad69a0554df8624a6ce0d5\"], \"id\": \"research-673e8dc214da9478bc45:b4b64e88992718a7:statement:ba16221a3c79e89e\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Risks of Depress as a Fire Suppression Technique in Spacecraft\", \"text\": \"Additionally, for materials that do achieve blow off during depress, residual heat remaining in \\nthe material can cause the material to reignite.\"}" ;
