    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"measured_observation\", \"evidence_ids\": [\"E-296c9003cc6b7365dc7a38f6\"], \"id\": \"research-673e8dc214da9478bc45:b4b64e88992718a7:statement:c57eaa03c36faaac\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Risks of Depress as a Fire Suppression Technique in Spacecraft\", \"text\": \"The test \\nshowed that common cabin materials continue to burn down to 11% oxygen with a balance of nitrogen, meaning that \\nachieving 11.7% O2  for Gateway would be at risk of not being an effective method of fire suppression even if \\nimplemented per the guidance provided.\"}" ;
