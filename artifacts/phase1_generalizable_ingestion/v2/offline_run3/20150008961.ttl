    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"experimental_configuration\", \"evidence_ids\": [\"E-501cf49397bf0765164ecfe5\"], \"id\": \"proposal-f8c1f60f43fbd38db4beb981\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Microgravity Flammability of PMMA Rods in Concurrent Flow\", \"text\": \"In quenching limit tests, the flow was incrementally turned down and the flame allowed to \\nstabilize at the new flow condition for at least the solid-phase response time before changing it again.\"}" ;
