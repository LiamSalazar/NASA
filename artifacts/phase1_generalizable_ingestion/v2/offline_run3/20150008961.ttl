ns1:proposal-054a8620ce7721bf311da4b7 a ns1:NASAConclusion ;
    ns1:canonical false ;
    ns1:evidenceRef "E-2a510aca56981d0ee2a06058" ;
    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"author_reported_conclusion\", \"evidence_ids\": [\"E-2a510aca56981d0ee2a06058\"], \"id\": \"proposal-054a8620ce7721bf311da4b7\", \"review_status\": \"APPROVED\", \"scope\": [\"research-5c3917d4f165b5bdd301:entity:825679bad1b75437a11d\"], \"scope_applicability\": \"Microgravity Flammability of PMMA Rods in Concurrent Flow\", \"text\": \"The blowoff \\nbranch exhibits a linear (Yox ~ a), trend that indicates there is a relatively constant critical \\ntemperature at blowoff.\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
    ns1:source ns1:research-5c3917d4f165b5bdd301%3A8cee8a023d9f0aab .

ns1:proposal-2c41556f8e029e244c5be1ab a ns1:NASAConclusion ;
    ns1:canonical false ;
    ns1:evidenceRef "E-073a752147138aad3f10501c" ;
    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"tentative_interpretation\", \"evidence_ids\": [\"E-073a752147138aad3f10501c\"], \"id\": \"proposal-2c41556f8e029e244c5be1ab\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Microgravity Flammability of PMMA Rods in Concurrent Flow\", \"text\": \"Later in the test program, we attempted to re-establish the \\nstagnation region after local blowoff by quickly reducing the flow to a value below the blowoff \\nvelocity, but we were only successful in one instance where the blowoff of the stagnation region may \\nnot have been complete (flame opening less than a thermal length, perhaps) due to the astronaut\\u2019s \\nquick response time.\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
    ns1:source ns1:research-5c3917d4f165b5bdd301%3A8cee8a023d9f0aab .

ns1:proposal-3a68f8e705640dca0add2c1b a ns1:ExperimentalCondition ;
    ns1:canonical false ;
    ns1:evidenceRef "E-a06680297147043e091d73fd" ;
    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"experimental_configuration\", \"evidence_ids\": [\"E-a06680297147043e091d73fd\"], \"id\": \"proposal-3a68f8e705640dca0add2c1b\", \"review_status\": \"APPROVED\", \"scope\": [\"research-5c3917d4f165b5bdd301:entity:828208648e7d4f90a1c8\"], \"scope_applicability\": \"Microgravity Flammability of PMMA Rods in Concurrent Flow\", \"text\": \"Twenty-four concurrent-flow tests were performed, focusing on finding flammability limits as a function \\nof oxygen and flow speed.\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
    ns1:source ns1:research-5c3917d4f165b5bdd301%3A8cee8a023d9f0aab .

ns1:proposal-3f114857aa8ec2066e5af67d a ns1:NASAConclusion ;
    ns1:canonical false ;
    ns1:evidenceRef "E-fbf7641d95c4f4bc72654389" ;
    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"tentative_interpretation\", \"evidence_ids\": [\"E-fbf7641d95c4f4bc72654389\"], \"id\": \"proposal-3f114857aa8ec2066e5af67d\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Microgravity Flammability of PMMA Rods in Concurrent Flow\", \"text\": \"The linear blowoff boundary has interesting implications in that it may be \\npossible to linearly extrapolate blowoff data down to zero stretch rate and use that oxygen value as a \\nconservative estimate of the minimum oxygen concentration where the material will burn.\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
    ns1:source ns1:research-5c3917d4f165b5bdd301%3A8cee8a023d9f0aab .

ns1:proposal-4e979d5e1e622422dc878885 a ns1:ExperimentalCondition ;
    ns1:canonical false ;
    ns1:evidenceRef "E-501cf49397bf0765164ecfe5" ;
    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"experimental_configuration\", \"evidence_ids\": [\"E-501cf49397bf0765164ecfe5\"], \"id\": \"proposal-4e979d5e1e622422dc878885\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Microgravity Flammability of PMMA Rods in Concurrent Flow\", \"text\": \"Conclusions \\nTwenty-four concurrent axial flow flammability tests with three diameters of cast PMMA \\ncylindrical rods were performed in the MSG on the ISS.\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
    ns1:source ns1:research-5c3917d4f165b5bdd301%3A8cee8a023d9f0aab .

ns1:proposal-5be151e143a52e7719c120ea a ns1:ExperimentalCondition ;
    ns1:canonical false ;
    ns1:evidenceRef "E-501cf49397bf0765164ecfe5" ;
    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"experimental_configuration\", \"evidence_ids\": [\"E-501cf49397bf0765164ecfe5\"], \"id\": \"proposal-5be151e143a52e7719c120ea\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Microgravity Flammability of PMMA Rods in Concurrent Flow\", \"text\": \"Flow velocity through the duct was also varied by changing the fan voltage, and \\nmeasured with a hot-wire anemometer.\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
    ns1:source ns1:research-5c3917d4f165b5bdd301%3A8cee8a023d9f0aab .

ns1:proposal-8635dd38cc231b841d54b9eb a ns1:ExperimentalCondition ;
    ns1:canonical false ;
    ns1:evidenceRef "E-501cf49397bf0765164ecfe5" ;
    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"experimental_configuration\", \"evidence_ids\": [\"E-501cf49397bf0765164ecfe5\"], \"id\": \"proposal-8635dd38cc231b841d54b9eb\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Microgravity Flammability of PMMA Rods in Concurrent Flow\", \"text\": \"Oxygen concentrations in the MSG \\nworking volume were varied during the testing from ambient ISS oxygen levels (~ 21% O2) down to \\n~14% O2, and oxygen concentrations before and after each test were measured with an on-board \\nCSA-CP sensor.\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
    ns1:source ns1:research-5c3917d4f165b5bdd301%3A8cee8a023d9f0aab .

ns1:proposal-aa71b67b77ed6ea53749263e a ns1:NASAConclusion ;
    ns1:canonical false ;
    ns1:evidenceRef "E-501cf49397bf0765164ecfe5" ;
    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"author_reported_conclusion\", \"evidence_ids\": [\"E-501cf49397bf0765164ecfe5\"], \"id\": \"proposal-aa71b67b77ed6ea53749263e\", \"review_status\": \"APPROVED\", \"scope\": [\"research-5c3917d4f165b5bdd301:entity:825679bad1b75437a11d\"], \"scope_applicability\": \"Microgravity Flammability of PMMA Rods in Concurrent Flow\", \"text\": \"For blowoff limit tests, the astronaut quickly turned up the flow to obtain extinction.\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
    ns1:source ns1:research-5c3917d4f165b5bdd301%3A8cee8a023d9f0aab .

ns1:proposal-beeb9f2266f79218f0f363c2 a ns1:NASAConclusion ;
    ns1:canonical false ;
    ns1:evidenceRef "E-2a510aca56981d0ee2a06058" ;
    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"author_reported_conclusion\", \"evidence_ids\": [\"E-2a510aca56981d0ee2a06058\"], \"id\": \"proposal-beeb9f2266f79218f0f363c2\", \"review_status\": \"APPROVED\", \"scope\": [\"research-5c3917d4f165b5bdd301:entity:825679bad1b75437a11d\"], \"scope_applicability\": \"Microgravity Flammability of PMMA Rods in Concurrent Flow\", \"text\": \"A surface energy balance is used \\nto show how the reductions in net flame heat flux at low stretch (low regression rates) drives the \\nflame to quenching extinction despite the fact that the losses actually decrease slightly near the limit.\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
    ns1:source ns1:research-5c3917d4f165b5bdd301%3A8cee8a023d9f0aab .

ns1:proposal-c25ef71e5fbde308f25988ed a ns1:NASAConclusion ;
    ns1:canonical false ;
    ns1:evidenceRef "E-fbf7641d95c4f4bc72654389" ;
    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"tentative_interpretation\", \"evidence_ids\": [\"E-fbf7641d95c4f4bc72654389\"], \"id\": \"proposal-c25ef71e5fbde308f25988ed\", \"review_status\": \"APPROVED\", \"scope\": [], \"scope_applicability\": \"Microgravity Flammability of PMMA Rods in Concurrent Flow\", \"text\": \"This \\nsuggests the Arrhenius temperature exponential term is dominant in the quenching region.\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
    ns1:source ns1:research-5c3917d4f165b5bdd301%3A8cee8a023d9f0aab .

ns1:proposal-c476c842755635a3e741855d a ns1:NASAConclusion ;
    ns1:canonical false ;
    ns1:evidenceRef "E-2a510aca56981d0ee2a06058" ;
    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"author_reported_conclusion\", \"evidence_ids\": [\"E-2a510aca56981d0ee2a06058\"], \"id\": \"proposal-c476c842755635a3e741855d\", \"review_status\": \"APPROVED\", \"scope\": [\"research-5c3917d4f165b5bdd301:entity:825679bad1b75437a11d\"], \"scope_applicability\": \"Microgravity Flammability of PMMA Rods in Concurrent Flow\", \"text\": \"The quenching branch exhibits an exponential (Yox versus a) curve which \\nreflects importance of heat losses to drop the flame temperature, causing the Arrhenius reaction rate \\nto slow to a critical Damkohler number while flow time is plentiful.\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
    ns1:source ns1:research-5c3917d4f165b5bdd301%3A8cee8a023d9f0aab .

ns1:proposal-cf6a94060b9d23365e2b591c a ns1:NASAConclusion ;
    ns1:canonical false ;
    ns1:evidenceRef "E-2a510aca56981d0ee2a06058" ;
    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"author_reported_conclusion\", \"evidence_ids\": [\"E-2a510aca56981d0ee2a06058\"], \"id\": \"proposal-cf6a94060b9d23365e2b591c\", \"review_status\": \"APPROVED\", \"scope\": [\"research-5c3917d4f165b5bdd301:entity:825679bad1b75437a11d\"], \"scope_applicability\": \"Microgravity Flammability of PMMA Rods in Concurrent Flow\", \"text\": \"Sub Topic: Fire Research \\n \\n10 \\nA flammability boundary with axes of oxygen concentration and forced stretch rate is obtained \\nthat has a distinctive shape that correlates well with a critical Damkohler number.\"}" ;
    ns1:reviewState "STAGED_CANDIDATE" ;
    ns1:source ns1:research-5c3917d4f165b5bdd301%3A8cee8a023d9f0aab .

