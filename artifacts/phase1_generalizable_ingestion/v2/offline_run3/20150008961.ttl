    ns1:payload "{\"authority\": \"RESEARCHER_CURATED\", \"epistemic\": \"measured_observation\", \"evidence_ids\": [\"E-073a752147138aad3f10501c\"], \"id\": \"research-5c3917d4f165b5bdd301:8cee8a023d9f0aab:statement:248407655e83559f\", \"review_status\": \"APPROVED\", \"scope\": [\"research-5c3917d4f165b5bdd301:entity:825679bad1b75437a11d\"], \"scope_applicability\": \"Microgravity Flammability of PMMA Rods in Concurrent Flow\", \"text\": \"This is \\nconsistent with tests for opposed flow flame spread rods that were also done as part of BASS-II [18], \\nwhere flame spread was not observed below 16.4 % O2.\"}" ;
