ns1:reviewed-llm-83b0a3d26d516850 a ns1:SafetyImplication ;
    ns1:canonical true ;
    ns1:evidenceRef "E-ntrs-20205007829-7-0" ;
    ns1:payload "{\"evidence_refs\": [{\"evidence_id\": \"E-ntrs-20205007829-7-0\", \"page\": 7, \"section\": null, \"source_id\": \"ntrs-20205007829\"}], \"evidence_span\": \"Given that the fire mitigations were effective, may allow the mission to continue, there is a possibility that with appropriate clean up that the vehicle could be restored and the mission could continue.\", \"modality\": null, \"normalized_text\": \"If fire mitigations are effective, it may allow the mission to continue; there is a possibility that with appropriate cleanup the vehicle could be restored and the mission could continue.\", \"reviewed_from_candidate\": \"llm-83b0a3d26d516850\", \"scope_applicability\": null, \"source_document\": \"ntrs-20205007829\", \"source_page\": 7, \"source_section\": null, \"statement_id\": \"reviewed-llm-83b0a3d26d516850\", \"statement_type\": \"safety_implication\", \"type\": \"SafetyStatementRecord\", \"uncertainty\": null}" ;
    ns1:source ns1:ntrs-20205007829 .

ns1:reviewed-llm-dc1ad80b2ba83a3c a ns1:SafetyImplication ;
    ns1:canonical true ;
    ns1:evidenceRef "E-ntrs-20205007829-7-0" ;
    ns1:payload "{\"evidence_refs\": [{\"evidence_id\": \"E-ntrs-20205007829-7-0\", \"page\": 7, \"section\": null, \"source_id\": \"ntrs-20205007829\"}], \"evidence_span\": \"Given that a fire may propagate in spite of early detection and initial response, there is a possibility that an active fire suppression system will need to be activated.\", \"modality\": null, \"normalized_text\": \"A fire may propagate despite early detection and initial response, and there is a possibility that an active fire suppression system will need to be activated.\", \"reviewed_from_candidate\": \"llm-dc1ad80b2ba83a3c\", \"scope_applicability\": null, \"source_document\": \"ntrs-20205007829\", \"source_page\": 7, \"source_section\": null, \"statement_id\": \"reviewed-llm-dc1ad80b2ba83a3c\", \"statement_type\": \"safety_implication\", \"type\": \"SafetyStatementRecord\", \"uncertainty\": null}" ;
    ns1:source ns1:ntrs-20205007829 .

ns1:saffire-iv-flow-off-20s a ns1:Intervention ;
    ns1:canonical true ;
    ns1:evidenceRef "E-safety-saffire-intervention" ;
    ns1:payload "{\"description\": \"For the Saffire-IV PMMA sample, we turned off the flow for 20 seconds.\", \"evidence_refs\": [{\"evidence_id\": \"E-safety-saffire-intervention\", \"page\": 16, \"section\": \"Fire Suppression Requirements\", \"source_id\": \"ntrs-20205007829\"}], \"id\": \"saffire-iv-flow-off-20s\", \"source_document\": \"ntrs-20205007829\", \"source_page\": 16, \"source_section\": \"Fire Suppression Requirements\", \"type\": \"InterventionRecord\"}" ;
    ns1:source ns1:ntrs-20205007829 .

ns1:saffire-iv-flow-off-observation a ns1:ReportedObservation ;
    ns1:canonical true ;
    ns1:evidenceRef "E-safety-saffire-observation" ;
    ns1:payload "{\"evidence_refs\": [{\"evidence_id\": \"E-safety-saffire-observation\", \"page\": 16, \"section\": \"Fire Suppression Requirements\", \"source_id\": \"ntrs-20205007829\"}], \"id\": \"saffire-iv-flow-off-observation\", \"phenomenon\": \"Flame persistence\", \"source_document\": \"ntrs-20205007829\", \"source_page\": 16, \"source_section\": \"Fire Suppression Requirements\", \"text\": \"The fire didn\\u2019t extinguish and began to grow when we turned the flow back on.\", \"type\": \"ObservationRecord\"}" ;
    ns1:source ns1:ntrs-20205007829 .

ns1:saffire-suppression-conclusion a ns1:NASAConclusion ;
    ns1:canonical true ;
    ns1:evidenceRef "E-safety-saffire-suppression-conclusion" ;
    ns1:payload "{\"evidence_refs\": [{\"evidence_id\": \"E-safety-saffire-suppression-conclusion\", \"page\": 16, \"section\": \"Fire Suppression Requirements\", \"source_id\": \"ntrs-20205007829\"}], \"normalized_text\": \"In a spacecraft, suppressant could have been used to \\u2018knock down\\u2019 the fire but wasn\\u2019t held at the desired concentration long enough for surface to cool.\", \"scope_applicability\": null, \"source_document\": \"ntrs-20205007829\", \"source_page\": 16, \"source_section\": \"Fire Suppression Requirements\", \"statement_id\": \"saffire-suppression-conclusion\", \"statement_type\": \"nasa_conclusion\", \"type\": \"SafetyStatementRecord\"}" ;
    ns1:source ns1:ntrs-20205007829 .

ns1:saffire-suppression-open-question a ns1:OpenQuestion ;
    ns1:canonical true ;
    ns1:evidenceRef "E-safety-saffire-suppression-open-question" ;
    ns1:payload "{\"evidence_refs\": [{\"evidence_id\": \"E-safety-saffire-suppression-open-question\", \"page\": 16, \"section\": \"Fire Suppression Requirements\", \"source_id\": \"ntrs-20205007829\"}], \"normalized_text\": \"Additional focused tests may be required to develop guidance on these questions.\", \"scope_applicability\": \"Qualification of spacecraft fire suppression under micro- or partial-gravity and suppressant concentration/hold time\", \"source_document\": \"ntrs-20205007829\", \"source_page\": 16, \"source_section\": \"Fire Suppression Requirements\", \"statement_id\": \"saffire-suppression-open-question\", \"statement_type\": \"open_question\", \"type\": \"SafetyStatementRecord\"}" ;
    ns1:source ns1:ntrs-20205007829 .

ns1:std-6001-applicability a ns1:Requirement ;
    ns1:canonical true ;
    ns1:evidenceRef "E-safety-std-6001-applicability" ;
    ns1:payload "{\"evidence_refs\": [{\"evidence_id\": \"E-safety-std-6001-applicability\", \"page\": 8, \"section\": \"1.2.1 Applicability\", \"source_id\": \"nasa-std-6001\"}], \"normalized_text\": \"Materials intended for use in space vehicles, specified test facilities, and contractually specified Ground Support Equipment (GSE) shall meet the requirements of this NASA Technical Standard.\", \"scope_applicability\": \"Materials intended for stated uses\", \"source_document\": \"nasa-std-6001\", \"source_page\": 8, \"source_section\": \"1.2.1 Applicability\", \"statement_id\": \"std-6001-applicability\", \"statement_type\": \"requirement\", \"type\": \"SafetyStatementRecord\"}" ;
    ns1:source ns1:nasa-std-6001 .

ns1:std-6001-worst-case-test a ns1:TestCriterion ;
    ns1:canonical true ;
    ns1:evidenceRef "E-safety-std-6001-worst-case-test" ;
    ns1:payload "{\"evidence_refs\": [{\"evidence_id\": \"E-safety-std-6001-worst-case-test\", \"page\": 17, \"section\": \"5 Applicable Material Tests\", \"source_id\": \"nasa-std-6001\"}], \"normalized_text\": \"Required tests shall be conducted on materials in their worst-case exposure conditions and representative use thicknesses and product forms.\", \"scope_applicability\": \"Required material tests\", \"source_document\": \"nasa-std-6001\", \"source_page\": 17, \"source_section\": \"5 Applicable Material Tests\", \"statement_id\": \"std-6001-worst-case-test\", \"statement_type\": \"test_criterion\", \"type\": \"SafetyStatementRecord\"}" ;
    ns1:source ns1:nasa-std-6001 .

