ns1:NASAStandard a owl:Class ;
    owl:equivalentClass <https://example.org/nasa-fire-safety#NASAStandard> .

ns1:Observation a owl:Class ;
    owl:equivalentClass <https://example.org/nasa-fire-safety#Observation> .

ns1:PressureCondition a owl:Class ;
