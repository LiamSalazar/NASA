ns1:configuration-design-criterion a ns1:DesignCriterion ;
    ns1:canonical true ;
    ns1:evidenceRef "E-safety-configuration-design-criterion" ;
    ns1:payload "{\"evidence_refs\": [{\"evidence_id\": \"E-safety-configuration-design-criterion\", \"page\": 1, \"section\": \"1.0 Introduction\", \"source_id\": \"ntrs-20150020937\"}], \"normalized_text\": \"It means controlling the quantity and configuration of such materials to eliminate potential fire propagation paths and thus ensure that any fire would be small, localized, and isolated, and would self-extinguish without harm to the crew.\", \"scope_applicability\": \"Crewed spacecraft fire control\", \"source_document\": \"ntrs-20150020937\", \"source_page\": 1, \"source_section\": \"1.0 Introduction\", \"statement_id\": \"configuration-design-criterion\", \"statement_type\": \"design_criterion\", \"type\": \"SafetyStatementRecord\"}" ;
    ns1:source ns1:ntrs-20150020937 .

