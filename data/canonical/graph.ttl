    rdfs:label "NASA Fire Safety Evidence Ontology v0.1" .

fs:AtmosphereCondition a owl:Class ;
    rdfs:subClassOf fs:ExperimentalCondition .

fs:Blowoff a owl:Class ;
    rdfs:subClassOf fs:CombustionPhenomenon .

fs:Extinction a owl:Class ;
    rdfs:subClassOf fs:CombustionPhenomenon .

fs:FlameGrowth a owl:Class ;
    rdfs:subClassOf fs:CombustionPhenomenon .

fs:FlameSpread a owl:Class ;
