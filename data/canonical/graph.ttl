fs:belongTo a owl:ObjectProperty .

fs:canonicalValue a owl:DatatypeProperty .

fs:concerns a owl:ObjectProperty .

fs:conditionType a owl:DatatypeProperty .

fs:configuration-design-criterion a fs:DesignCriterion ;
    fs:evidenceRef "E-safety-configuration-design-criterion" ;
    fs:reportedBy fs:ntrs-20150020937 ;
    fs:scopeApplicability "Crewed spacecraft fire control" ;
    fs:text "It means controlling the quantity and configuration of such materials to eliminate potential fire propagation paths and thus ensure that any fire would be small, localized, and isolated, and would self-extinguish without harm to the crew." .

fs:configuration-guidance a fs:Guidance ;
    fs:evidenceRef "E-safety-configuration-guidance" ;
    fs:reportedBy fs:ntrs-20150020937 ;
    fs:scopeApplicability "Payload hardware flammability assessment" ;
    fs:text "The document provides guidance in conducting the flammability assessments required for payload hardware by SSP 51700." .

fs:evidenceRef a owl:DatatypeProperty .

fs:guidance-ntrs-20150020937 a fs:Guidance ;
    fs:evidenceRef "E-ntrs-20150020937-2-0" ;
    fs:text "The document provides guidance in conducting the flammability assessments required for payload hardware by SSP 51700, \"Payload Safety Policy and Requirements for the International Space Station\"." .

fs:hasCondition a owl:ObjectProperty .

fs:hasIntervention a owl:ObjectProperty .

fs:hasMeasurement a owl:ObjectProperty .

fs:hasObservation a owl:ObjectProperty .

fs:hasRun a owl:ObjectProperty .

fs:madeOf a owl:ObjectProperty .

fs:nasa_conclusion-ntrs-20205007829 a fs:NASAConclusion ;
    fs:evidenceRef "E-ntrs-20205007829-14-0" ;
    fs:text "What is the perceived risk for a spacecraft fire?  Programs that have conducted probabilistic risk assessments have generally rated the fire risk very low – Depending on assumptions, risk of Loss of Vehicle by a fire could be on the order of 1 in 300,000 to 1 in 3,000,000 To a Program Manager, low probabilities indicate a fire event is very unlikely – In some cases, there is no real belief that a fire could occur  This drives decisions that impact how a vehicle program addresses the fire risk beginning in the design phase – Flammability and material control – Isolation from ignition sources – Detection – Suppression  This trend will probably continue unless we provide a clear set of requirements and/or guidelines that all Programs need to follow 14" .

fs:observesPhenomenon a owl:ObjectProperty .

fs:open_question-ntrs-20205007829 a fs:NASAIdentifiedOpenQuestion ;
    fs:evidenceRef "E-ntrs-20205007829-2-0" ;
    fs:text "Operating in the Lunar Vicinity (proving ground) After 2030 Leaving the Earth-Moon System and Reaching Mars Orbit Now 2020s EXPANDING HUMAN PRESENCE IN PARTNERSHIP CREATING ECONOMIC OPPORTUNITIES, ADVANCING TECHNOLOGIES, AND ENABLING DISCOVERY No matter the mission or the destination, each will present unique fire safety challenges for spacecraft or habitats Spacecraft designers and mission operations personnel will (generally) not realize the extent of the fire safety question they need answered until a solution is needed (quickly) 2" .

fs:psi-25 a fs:Investigation ;
    fs:evidenceRef "E-psi-25-metadata" ;
    fs:hasRun fs:psi-25-B1 ;
    fs:title "BASS-II" .

fs:reportedBy a owl:ObjectProperty .

fs:saffire-suppression-conclusion a fs:NASAConclusion ;
    fs:concerns fs:psi-98 ;
    fs:evidenceRef "E-safety-saffire-suppression-conclusion" ;
    fs:reportedBy fs:ntrs-20205007829 ;
    fs:supportedBy fs:saffire-iv-flow-off-observation ;
    fs:text "In a spacecraft, suppressant could have been used to ‘knock down’ the fire but wasn’t held at the desired concentration long enough for surface to cool." .

fs:saffire-suppression-open-question a fs:NASAIdentifiedOpenQuestion ;
    fs:concerns fs:psi-98 ;
    fs:evidenceRef "E-safety-saffire-suppression-open-question" ;
    fs:reportedBy fs:ntrs-20205007829 ;
    fs:scopeApplicability "Qualification of spacecraft fire suppression under micro- or partial-gravity and suppressant concentration/hold time" ;
    fs:supportedBy fs:saffire-iv-flow-off-observation ;
    fs:text "Additional focused tests may be required to develop guidance on these questions." .

fs:std-6001-applicability a fs:Requirement ;
    fs:evidenceRef "E-safety-std-6001-applicability" ;
    fs:reportedBy fs:nasa-std-6001 ;
    fs:scopeApplicability "Materials intended for stated uses" ;
    fs:text "Materials intended for use in space vehicles, specified test facilities, and contractually specified Ground Support Equipment (GSE) shall meet the requirements of this NASA Technical Standard." .

fs:std-6001-worst-case-test a fs:TestCriterion ;
    fs:evidenceRef "E-safety-std-6001-worst-case-test" ;
    fs:reportedBy fs:nasa-std-6001 ;
    fs:scopeApplicability "Required material tests" ;
    fs:text "Required tests shall be conducted on materials in their worst-case exposure conditions and representative use thicknesses and product forms." .

fs:suppression-system-implication a fs:SafetyImplication ;
    fs:evidenceRef "E-safety-suppression-system-implication" ;
    fs:reportedBy fs:ntrs-20205007829 ;
    fs:scopeApplicability "Fire suppression" ;
    fs:text "Given that a fire may propagate in spite of early detection and initial response, there is a possibility that an active fire suppression system will need to be activated." .

fs:usesSample a owl:ObjectProperty .

fs:value a owl:DatatypeProperty .

