OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Persistent credentials are supplied locally; never commit their values.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
TYPESAFE_API_KEY=
HIERARCHICAL_SEMANTIC_RETRIEVAL_ENABLED=false
RELATIONAL_RELATED_RETRIEVAL_ENABLED=false
SEMANTIC_QUERY_EXPANSION_ENABLED=false
CONTEXTUAL_RERANKING_ENABLED=false
SELECTIVE_CONTEXTUAL_RERANKING_ENABLED=false
JEV_ADVISORY_TRIAGE_ENABLED=false
SCIENTIFIC_PARAPHRASE_ENABLED=false

# Additive projection of existing ontology associations; experimental, disabled by default.
ONTOLOGY_GRAPH_ENRICHMENT_ENABLED=false
SOURCE_KNOWLEDGE_ENRICHMENT_ENABLED=false

# Phase 3C validated structured identities and source crosswalks (opt-in).
PSI_STRUCTURED_PUBLICATION_ENABLED=false
FLEX_SOURCE_CORRECTIONS_ENABLED=false
