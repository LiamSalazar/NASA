@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sem: <https://example.org/nasa-fire-safety/semantic/> .
@prefix shapes: <https://example.org/nasa-fire-safety/shapes/> .

# Technical validation shapes introduce no new scientific concepts.
shapes:ReviewedTaxonomyStatement a sh:NodeShape ;
    sh:targetClass rdf:Statement ;
    sh:property [ sh:path rdf:subject ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path rdf:predicate ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( rdfs:subClassOf rdf:type owl:sameAs skos:broader skos:related skos:exactMatch ) ] ;
    sh:property [ sh:path rdf:object ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path sem:payload ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path sem:evidenceRef ; sh:minCount 1 ] .
