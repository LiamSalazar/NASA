# Python environments and tooling
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/

# Local logs, temporary files and editor swap files
*.log
*.tmp
*.swp
*.swo

# Local configuration and secrets
.env
.env.*
!.env.example

# Generated local application state (rebuild with scripts)
data/index/*.sqlite
data/index/*.sqlite-*
data/index/*.npy
data/index/*.npz
data/index/*.wal
data/index/*.shm
data/index/consolidation_vectors/
# Generated contextual applicability indexes; source-backed receipts and reports
# under artifacts/ remain versioned.
data/index/scientific_context_*.json
data/index/autonomy_vectors/

# Local autonomous/consolidation runs and downloaded research inputs
artifacts/phase3c_autonomy_*
artifacts/phase3c_consolidation_*
data/raw/autonomous/

# Local test fixtures and execution scratch space
artifacts/**/test-fixtures/
artifacts/**/*.journal
artifacts/**/*.sqlite-journal

# Rebuildable evaluation databases; retain JSON/JSONL results and RDF snapshots
artifacts/**/*.sqlite
artifacts/**/*.sqlite-*
artifacts/**/*.db
artifacts/**/*.db-*
artifacts/**/*.sqlite.gz

# Phase 3C execution workspaces and generated bundles can contain local
# databases, extracted source material and large reproducibility payloads.
# Keep the public repository focused on source, tests and versioned reports.
artifacts/phase3c_*/
!artifacts/phase3c_*/README.md
*.zip
*.zip.sha256

# Local submission/canonical state generated by development runs
data/submissions/
data/canonical/research/

# Downloaded holdout binaries remain local; manifests/checksums/metadata are versioned
artifacts/phase3c_holdout_acquisition/*.pdf
artifacts/phase3c_corrective_holdout_acquisition*/*.pdf

# Python packaging/build output
build/
dist/
*.egg-info/
.coverage
.coverage.*
htmlcov/

# Streamlit and editor state
.streamlit/secrets.toml
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Phase 1 reproducible runtime workspaces and downloaded originals remain local.
# Source identity manifests, execution receipts and deliberate tests/fixtures stay versioned.
artifacts/phase1_generalizable_ingestion/**/workspace/
artifacts/phase1_generalizable_ingestion/**/*.pdf
